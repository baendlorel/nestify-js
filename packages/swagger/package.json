{
  "name": "@nestify-js/swagger",
  "version": "0.2.1",
  "description": "Swagger/OpenAPI integration for nestify-js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "swagger",
    "openapi",
    "documentation",
    "fastify"
  ],
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@nestify-js/core": "workspace:*",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.0",
    "rollup-plugin-func-macro": "^1.2.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}
