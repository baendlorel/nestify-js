{
  "name": "nestify-js",
  "version": "0.5.1",
  "description": "A NestJS like fastify plugin for dependency injection",
  "description_zh": "一个类似于 NestJS 的 Fastify 依赖注入插件",
  "purpose": "npm",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baendlorel/nestify-js"
  },
  "keywords": [
    "nestjs",
    "decorator",
    "fastify",
    "typescript",
    "javascript"
  ],
  "license": "MIT",
  "dependencies": {
    "@nestify-js/core": "workspace:*",
    "@nestify-js/shared": "workspace:^*",
    "@fastify/autoload": "^6.3.1",
    "@fastify/one-line-logger": "^2.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.0.0"
  },
  "peerDependencies": {
    "@fastify/multipart": "^9.3.0"
  },
  "peerDependenciesMeta": {
    "@fastify/multipart": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.0",
    "rollup-plugin-func-macro": "^1.2.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  }
}