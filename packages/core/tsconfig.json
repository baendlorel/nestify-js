{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "stripInternal": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@core/*": ["./src/*"],
      "@nestify-js/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
