{
  "name": "@nestify-js/core",
  "version": "0.4.1",
  "description": "Core dependency injection system for nestify-js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.cjs",
      "require": "./dist/index.cjs"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.mjs",
      "default": "./dist/test.cjs",
      "require": "./dist/test.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dependency-injection",
    "decorators",
    "ioc",
    "typescript"
  ],
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@nestify-js/shared": "workspace:^*",
    "cron-parser": "^5.6.1",
    "fastify": "^5.9.0",
    "reflect-deep": "^2.0.1",
    "serial-task": "^1.2.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@fastify/multipart": "^10.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^26.1.0",
    "rollup-plugin-func-macro": "^1.2.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "dec": "rg \"^[\\s]{0,}@[a-zA-Z]+\\(\" src/",
    "check": "tsc --noEmit",
    "test": "vitest"
  }
}